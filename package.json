{
  "name": "shorts-studio",
  "version": "0.1.0",
  "description": "Topic in, finished short out. Open-source starter for reelsdk.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "deploy": "vite build && wrangler deploy",
    "deploy:demo": "CLOUDFLARE_ENV=demo vite build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/anybody": "^5.3.0",
    "@fontsource-variable/spline-sans": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/workers-types": "^5.20261025.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.152.0"
  },
  "cloudflare": {
    "bindings": {
      "REELSDK_KEY": {
        "description": "Your reelsdk key (`rsdk_live_...`). Get one at [reelsdk.com](https://reelsdk.com)."
      }
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "overrides": {
      "undici@>=7.0.0 <7.30.1": "^7.30.1"
    }
  }
}
